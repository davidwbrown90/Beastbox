# iOS (Capacitor) build artifacts — regenerated by `pod install` / Xcode,
# machine-specific, shouldn't be committed. The App.xcodeproj/xcworkspace
# project files themselves ARE committed (Capacitor needs those checked in).
ios/App/Pods
ios/App/build
ios/App/DerivedData
ios/App/**/*.xcuserstate
ios/App/**/xcuserdata/
